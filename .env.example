# ──────────────────────────────────────────────
# Environment Configuration
# Copy this file to .env and fill in your keys
# ──────────────────────────────────────────────

# ── LLM Provider ──
# Options: groq, ollama, openai, anthropic, gemini
DEFAULT_LLM_PROVIDER=groq

# ── Groq API (Primary Cloud LLM) ──
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# ── Ollama (Local Fallback) ──
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_FALLBACK_MODEL=deepseek-r1

# ── Optional Cloud LLM Keys ──
# OPENAI_API_KEY=sk-your_key_here
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# GOOGLE_API_KEY=your_key_here

# ── Application Settings ──
DATA_PATH=data/cleaned_enterprise_multiagent_decision_support.csv
RAW_DATA_PATH=data/raw/enterprise_multiagent_decision_support.csv
OUTPUTS_PATH=outputs/
LOG_LEVEL=INFO

# ── ChromaDB (RAG Vector Store) ──
CHROMA_PERSIST_DIR=.chroma_db
